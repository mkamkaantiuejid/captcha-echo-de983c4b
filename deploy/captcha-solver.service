[Unit]
Description=Captcha Solver HTTP sidecar (CloakBrowser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=captcha
Group=captcha
WorkingDirectory=/opt/captcha-solver
Environment=BROWSER_HEADLESS=0
Environment=PORT=8877
# Optional overrides: copy deploy/env.optional.example → /opt/captcha-solver/.env
# EnvironmentFile=-/opt/captcha-solver/.env
# Headed browsers on headless servers need a virtual display
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1920x1080x24" \
    /opt/captcha-solver/venv/bin/python server.py
Restart=always
RestartSec=5
# Solves can run 60–120s; give the unit time to stop cleanly
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target
