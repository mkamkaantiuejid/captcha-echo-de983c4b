# Optional — only if you inject settings via systemd EnvironmentFile or your shell.
# The service defaults PORT=8877 and BROWSER_HEADLESS=0 without this file.
# Mistral models: use common/mistral.json (dashboard Global Setup) instead.

# PORT=8877
# BROWSER_HEADLESS=0
# SOLVER_PUBLIC_URL=https://solver.yourdomain.com
# TURNSTILE_GEOIP=1
# RECAPTCHA_GEOIP=1
# SOLVER_ALLOW_PRIVATE=1
